{
  "name": "workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm",
  "dependencies": {
    "@fontsource/instrument-sans": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@tiptap/extension-bubble-menu": "3.34.0",
    "@tiptap/pm": "3.34.0",
    "@tiptap/react": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "@vinext/cloudflare": "1.3.4",
    "@xyflow/react": "13.0.0",
    "lucide-react": "1.73.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "vinext": "1.4.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.17",
    "@cloudflare/vitest-plugin": "1.8.3",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitejs/plugin-rsc": "0.5.39",
    "cf": "1.0.0-beta.32",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "vite preview",
    "deploy": "npm run deploy:configured",
    "preview": "npm run build && npm run start --",
    "cf-typegen": "cf workers types",
    "format": "prettier --write .",
    "typecheck": "cf workers types && tsc --noEmit",
    "test": "vitest run",
    "test:deploy": "node --test tests/deploy.test.mjs",
    "test:e2e": "playwright test",
    "db:migrate:local": "cf d1 migrations apply 00000000-0000-4000-8000-000000000001 --local --mode development",
    "deploy:configured": "npm run build && node scripts/deploy.mjs"
  },
  "overrides": {
    "fflate": "0.7.5"
  }
}
